    "lint:deps": "depcruise src --config .dependency-cruiser.jsonc --output-type err-long",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-router": "1.170.44",
    "lucide-react": "1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@swc/core": "1.16.18",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.46",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "18.6.0",
    "jsdom": "30.1.3",
    "oxc-transform-react": "^0.152.0",
    "playwright": "^1.64.0",
    "storybook": "^10.6.2",
    "stylelint": "17.16.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
