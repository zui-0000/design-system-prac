{
  "name": "design-system-prac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vp build",
    "prepare": "vp config && playwright install chromium",
    "storybook": "storybook dev -p 6006",
